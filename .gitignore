# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
# Lint / 类型检查缓存（mypy/ruff 自带 .gitignore 兜底，显式声明防子目录漏网）
.mypy_cache/
.ruff_cache/

# Node
node_modules/
dist/
build/
.vite/

# Data
data/*.db
data/*.json
!data/.gitkeep

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swoop

# Env
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# Obsidian
.obsidian/

# TypeScript/Vite 产物
apps/web/tsconfig.tsbuildinfo

# Playwright / 浏览器自动化产物（截图、录屏）
.playwright-cli/
.playwright-mcp/
# 注意：不要用全局 *.png/*.jpg —— 会误伤 docs/ 架构图与 apps/web/public/ 静态资源。
# 只忽略明确的截图产物目录：
tmp/*.png
tmp/*.jpg
tmp/*.jpeg
.playwright-cli/*.png
.playwright-mcp/*.png

# Local AI / agent state
.reasonix/

# 本地临时脚本/冒烟产物（可能含密钥与截图，禁止入库）
tmp/
.zcode/

# 工具缓存与本地配置（§4.1.5）
.claude/
.pytest_cache/
*.pkg

# CodeGraph 本地索引（.codegraph/ 为生成产物，可随时 codegraph init 重建）
.codegraph/

# Mimosa 安全扫描产物（本地 finding ledger / hook state，含会话级缓存）
.mimosa/
# Mimo 工具会话状态（含 cron-lock 与 plans，会话级，禁止入库）
.mimocode/
# 临时参考仓（图谱开发用，审查后删除）
vendor/

# 数据缓存（repo-cache 为克隆缓存，graph-db 为图谱索引；DB 备份均禁止入库）
data/repo-cache/
data/graph-db/
data/graph-engine-cache/
data/*.bak*
data/app.db.bak*
data/*.db-shm
data/*.db-wal

# 图谱引擎构建产物（C core + layout；全局 build/ 已覆盖，此处显式声明）
services/graph/engines/c/core/build/
services/graph/engines/c/layout/build/

# 运行期数据（"它的脑"）与 agent 工作区（"它的家"）：内容为用户数据，不入库；
# 目录结构经 git add -f 保留 README
runtime-data/
workspace/

# 各服务独立运行时的默认数据目录（含 SQLite / 密钥 / 引擎产物）
services/*/data/


# 开发阶段执行文档(过程性产物,随迭代过时,不入库)
docs/phases/

# 本地讲解/学习站与生成脚本（不入库）
docs-site/

# 本地走查截图（不入库；docs/ 架构图与 public 静态资源仍提交）
screenshots/

# —— 迁移期备份(RepoPilot 旧 page / widget / shell 在探索阶段保留,不入库)——
apps/web/src/_archived_*
apps/web/src/**/_archived_*
apps/web/src/_legacy_*
