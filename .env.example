# Voyager 环境变量示例 —— 复制为仓库根目录 `.env` 后按需修改
# 切勿把含真实密钥的 `.env` 提交入库

# 必填：JWT 签名密钥，长度不少于 32 字节
SECRET_KEY=change-me-to-a-long-random-secret-key

# 建议：与 JWT 分离的敏感字段 at-rest 加密密钥（Fernet 派生）
# SECRETS_ENCRYPTION_KEY=

# 可选：SQLite 路径（默认仓库根 data/app.db）
# DATABASE_URL=sqlite:///./data/app.db

# 开发调试（生产务必 false）
DEBUG=false

# CORS 允许源（逗号分隔）；生产请显式配置前端域名
# CORS_ALLOW_ORIGINS=https://app.example.com

# Cookie：生产默认 Secure+Lax；跨端口本地开发可保持 DEBUG=true
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SAMESITE=lax

# Agent 独立进程（可选）。未设置时 Hub 与 API 同进程。
# AGENT_BASE_URL=http://127.0.0.1:19877
# AGENT_INTERNAL_TOKEN=change-me-agent-internal-token
# 彻底禁用 Agent 服务（含 API 进程内 Hub）→ agent 端点 503 兜底：
# AGENT_DISABLED=1

# 后端/Agent 开发端口（npm run dev:api / dev:agent 与 scripts/dev.ps1 读取；默认 19878/19877）
# API_PORT=19878
# AGENT_PORT=19877

# 图谱 C 引擎 sidecar（迁入 services/graph_engine/graph_engine_core，默认 :9750）
# 默认空 = 严格两进程模式（进程内 Python 回退，装即用）；
# 需 C 引擎性能时取消下行注释并构建二进制（见 services/graph_engine/README.md）。
# 彻底禁用图谱引擎（含进程内回退）→ graph_l1 503 兜底，graph_l0 纯 DB 投影不受影响：
# GRAPH_DISABLED=1
# GRAPH_ENGINE_URL=http://127.0.0.1:9750
# GRAPH_ENGINE_BIN=  # 可选；默认找 services/graph_engine/graph_engine_core/build/c/graph-engine*
# GRAPH_CACHE_DIR=   # 可选；默认 data/graph-engine-cache
# GRAPH_ALLOWED_ROOT=
# GRAPH_AUTO_START=true

# 限流
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_AGENT=20/minute
