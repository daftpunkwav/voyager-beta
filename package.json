{
  "name": "app",
  "private": true,
  "version": "2.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "postcss": {
      "nanoid": "^3.3.18"
    }
  },
  "scripts": {
    "dev:web": "npm run dev -w web",
    "build:web": "npm run build -w web",
    "preview:web": "npm run preview -w web",
    "test:web": "npm run test -w web",
    "lint:web": "npm run lint -w web",
    "typecheck:web": "npm run typecheck -w web",
    "lint:py": "ruff check platform agent services",
    "test:py": "pytest platform agent services/_template -q",
    "audit:web": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0"
  },
  "lint-staged": {
    "apps/web/src/**/*.{ts,tsx}": [
      "eslint --max-warnings 0"
    ],
    ".env": [
      "echo '错误: .env 文件禁止提交,请先从暂存区移除!' && exit 1"
    ],
    ".env.local": [
      "echo '错误: .env.local 文件禁止提交,请先从暂存区移除!' && exit 1"
    ],
    ".env.*.local": [
      "echo '错误: 本地 .env 文件禁止提交,请先从暂存区移除!' && exit 1"
    ]
  }
}
